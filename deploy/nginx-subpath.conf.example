# Include inside the existing HTTPS server block.
# Create the password file separately, or reuse the existing workspace's file.
# Keep the credentials outside this repository.
location = /market-radar {
    return 308 /market-radar/;
}
location ^~ /market-radar/ {
    auth_basic "Market Radar Private Workspace";
    auth_basic_user_file /etc/nginx/market-radar.htpasswd;
    if ($http_origin !~ "^(https://myaistock\.top)?$") { return 403; }
    proxy_pass http://127.0.0.1:8788/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 10s;
    proxy_read_timeout 360s;
    client_max_body_size 2m;
    gzip on;
    gzip_types application/javascript application/json text/css;
    gzip_min_length 1024;
    gzip_vary on;
}
